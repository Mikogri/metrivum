<Project>
  <!-- Machine credentials must never travel with API, worker, test or publish artifacts. -->
  <ItemGroup>
    <Content Update="appsettings.Local.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
    <None Update="appsettings.Local.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
  </ItemGroup>
  <!-- Exclusions do not remove credentials left in output folders by older builds. -->
  <Target Name="RemoveStaleLocalConfiguration" AfterTargets="Build;Publish">
    <Delete Files="$(TargetDir)appsettings.Local.json" Condition="'$(TargetDir)' != ''" />
    <Delete Files="$(PublishDir)appsettings.Local.json" Condition="'$(PublishDir)' != ''" />
  </Target>
</Project>
