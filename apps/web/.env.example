# Copy to apps/web/.env.local for local development. Only public, browser-safe values belong here.
# Never put service_role/secret keys or PostgreSQL connection strings in VITE_* variables.

# ASP.NET API base URL (no trailing slash).
VITE_API_URL=http://localhost:5080
# Supabase project URL and the publishable (anon) key. Auth only; the Data API is not used.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_PUBLISHABLE_KEY
# Public origin used for canonical URLs, sitemap and hreflang in pre-rendered HTML.
VITE_SITE_URL=http://localhost:5173
# Optional: "1" enables the explicitly labelled developer mock API (never a fallback for real errors).
VITE_DEV_MOCKS=0
# Optional: address shown under Settings → Sign-in and security → Recovery methods for account recovery requests.
VITE_SUPPORT_EMAIL=

# Turnstile Managed widget public site key. Secret belongs only in Supabase Auth CAPTCHA settings.
# Development may omit both values if its separate Supabase project has CAPTCHA disabled.
VITE_TURNSTILE_SITE_KEY=
# Production defaults to required; false is an explicit staged rollout override before Auth enforcement.
# Once Supabase enforces CAPTCHA this must be true. Never use test keys in production.
VITE_AUTH_CAPTCHA_REQUIRED=
