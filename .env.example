ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__Database=Host=127.0.0.1;Port=54322;Database=postgres;Username=trainflow_api;Password=REPLACE_LOCALLY;Maximum Pool Size=20
ConnectionStrings__MigrationDatabase=Host=127.0.0.1;Port=54322;Database=postgres;Username=trainflow_migrator;Password=REPLACE_LOCALLY;Maximum Pool Size=5
Supabase__Auth__ProjectUrl=http://127.0.0.1:54321
Supabase__Auth__Audience=authenticated
