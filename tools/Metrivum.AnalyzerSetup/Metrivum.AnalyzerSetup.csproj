<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyTitle>Metrivum Analyzer Setup</AssemblyTitle>
    <Product>Metrivum Analyzer Setup</Product>
    <Description>Metrivum local video analyzer installer</Description>
  </PropertyGroup>
  <ItemGroup><EmbeddedResource Include="$(ReleaseManifest)" LogicalName="release.json" /></ItemGroup>
</Project>
