<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>Analysis.Bridge</AssemblyName>
    <MotionTraceRoot Condition="'$(MotionTraceRoot)' == ''">$(MSBuildThisFileDirectory)../../../MotionTrace</MotionTraceRoot>
    <DefaultItemExcludes>$(DefaultItemExcludes);artifacts/**;bin/**;obj/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <None Include="preprocess.py" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <ProjectReference Include="$(MotionTraceRoot)/src/MotionTrace.Infrastructure/MotionTrace.Infrastructure.csproj" />
    <ProjectReference Include="$(MotionTraceRoot)/src/MotionTrace.Core/MotionTrace.Core.csproj" />
  </ItemGroup>
</Project>
