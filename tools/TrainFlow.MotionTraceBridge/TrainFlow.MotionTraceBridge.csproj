<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <MotionTraceRoot Condition="'$(MotionTraceRoot)' == ''">$(MSBuildThisFileDirectory)../../../MotionTrace</MotionTraceRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <ProjectReference Include="$(MotionTraceRoot)/src/MotionTrace.Infrastructure/MotionTrace.Infrastructure.csproj" AdditionalProperties="UseArtifactsOutput=true;ArtifactsPath=$(MSBuildThisFileDirectory)artifacts" />
    <ProjectReference Include="$(MotionTraceRoot)/src/MotionTrace.Core/MotionTrace.Core.csproj" AdditionalProperties="UseArtifactsOutput=true;ArtifactsPath=$(MSBuildThisFileDirectory)artifacts" />
  </ItemGroup>
</Project>
