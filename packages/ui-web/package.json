{
  "name": "@portable-ui/react",
  "version": "0.1.0",
  "description": "Portable accessible React components with configurable copy, responsive overlays and CSS themes.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens/tokens.css",
    "./light.css": "./dist/tokens/light.css",
    "./fonts.css": "./dist/styles/fonts.css"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.build.json --noEmit --emitDeclarationOnly false",
    "build": "vite build && tsc -p tsconfig.build.json && node build-styles.mjs",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@internationalized/date": "3.12.4",
    "lucide-react": "1.52.0",
    "react-aria-components": "1.21.1"
  },
  "devDependencies": {
    "@storybook/react-vite": "10.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vite": "8.3.5",
    "typescript": "5.9.3"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "restricted"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts"
}
