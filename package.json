{
  "name": "metrivum",
  "private": true,
  "packageManager": "npm@11.21.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/web",
    "apps/ui-catalog",
    "apps/mobile"
  ],
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "npm": ">=11.21.0 <13"
  },
  "scripts": {
    "contracts": "openapi-typescript contracts/generated/openapi.json -o contracts/generated/api.d.ts",
    "dev": "npm run dev --workspace @metrivum/web",
    "build": "npm run build --workspace @metrivum/web",
    "preview": "npm run preview --workspace @metrivum/web",
    "storybook": "npm run storybook --workspace @metrivum/ui-catalog",
    "storybook:build": "npm run build --workspace @metrivum/ui-catalog",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "vitest run",
    "test:hosting": "node --test apps/web/scripts/hosting-rules.test.mjs apps/web/scripts/prepare-build.test.mjs",
    "test:security-dependencies": "node --test infra/security-dependencies/node-forge.test.cjs infra/security-dependencies/parsers.test.mjs infra/security-dependencies/installed-parsers.test.mjs",
    "e2e": "npm run e2e --workspace @metrivum/web",
    "e2e:coaching": "npm run e2e:coaching --workspace @metrivum/web",
    "catalog:seed": "node infra/catalog/build-catalog-seed.mjs",
    "dev:mobile": "npm run dev --workspace @metrivum/mobile",
    "format:api": "dotnet csharpier format apps/api backend workers tools tests infra",
    "format:api:check": "dotnet csharpier check apps/api backend workers tools tests infra",
    "format:frontend": "prettier --write \"{apps/web,apps/mobile,apps/ui-catalog,packages,contracts,test}/**/*.{ts,tsx,js,jsx,mjs,cjs,css,scss,less,html,json,jsonc,md,mdx,yml,yaml}\" \"*.{js,mjs,cjs,ts,json}\" \".vscode/*.json\"",
    "format:frontend:check": "prettier --check \"{apps/web,apps/mobile,apps/ui-catalog,packages,contracts,test}/**/*.{ts,tsx,js,jsx,mjs,cjs,css,scss,less,html,json,jsonc,md,mdx,yml,yaml}\" \"*.{js,mjs,cjs,ts,json}\" \".vscode/*.json\"",
    "pretypecheck": "npm run build --workspace @portable-ui/react",
    "build:ui": "npm run build --workspace @portable-ui/react"
  },
  "overrides": {
    "braces": "$braces",
    "decode-uri-component": "$decode-uri-component",
    "node-forge": "$node-forge",
    "xcode": {
      "uuid": "11.1.1"
    }
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.1",
    "braces": "file:./vendor/braces",
    "decode-uri-component": "file:./vendor/decode-uri-component",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "node-forge": "file:./vendor/node-forge",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
